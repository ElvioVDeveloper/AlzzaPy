{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "System administrator and partner profiles with dashboard access",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID of administrator",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Full name or display name of the administrator",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the administrator",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "enum": ["admin", "superadmin"],
          "description": "Role authorization level"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when the admin record was created"
        }
      },
      "required": ["id", "name", "email", "role", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Gastronomic dish or signature cocktail item displayed on the landing page",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Product or service name",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Gastronomic description and tasting notes",
          "maxLength": 1000
        },
        "price": {
          "type": "string",
          "description": "Formatted price (e.g. Gs. 55.000)",
          "maxLength": 50
        },
        "image": {
          "type": "string",
          "description": "High resolution image URL of the product",
          "maxLength": 1500
        },
        "category": {
          "type": "string",
          "description": "Culinary or mixology category",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["activo", "inactivo"],
          "description": "Visibility state on public landing page"
        },
        "badge": {
          "type": "string",
          "description": "Highlight badge or label (e.g. Firma Elevva, Recomendado)",
          "maxLength": 60
        },
        "tag": {
          "type": "string",
          "description": "Sensory profile tag (e.g. Aromático • Floral)",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last modification timestamp"
        }
      },
      "required": ["name", "description", "price", "image", "category", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Culinary or mixology category classifying menu items and landing filter tabs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique category identifier",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Display name of the category",
          "maxLength": 80
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly unique slug identifier",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "description": "Short category description or subtitle",
          "maxLength": 255
        },
        "order": {
          "type": "number",
          "description": "Display sequence order for tabs on the landing page"
        },
        "icon": {
          "type": "string",
          "description": "Icon identifier for tab visuals",
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "enum": ["activo", "inactivo"],
          "description": "Visibility status on the landing page"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last modification timestamp"
        }
      },
      "required": ["name", "slug", "order", "status"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Collection of authorized administrators and partners"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of services and products dynamically rendered on the commercial landing page"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Menu categories defining filter tabs and navigation order"
    }
  }
}
