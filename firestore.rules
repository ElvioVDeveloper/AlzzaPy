rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'danielalvarenga751@gmail.com' ||
        request.auth.token.email == 'developer@developer.com'
      );
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Product validation helper
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.description is string && data.description.size() <= 1000
        && data.price is string && data.price.size() <= 50
        && data.image is string && data.image.size() <= 1500
        && data.category is string && data.category.size() <= 80
        && data.status in ['activo', 'inactivo'];
    }

    // Category validation helper
    function isValidCategory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 80
        && data.order is number
        && data.status in ['activo', 'inactivo'];
    }

    // Admin collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Products collection (dynamically displayed on landing page)
    match /products/{productId} {
      // Public visitors can read active products; Admins can read all products
      allow get, list: if resource.data.status == 'activo' || isAdmin();

      // Only verified administrators can mutate products
      allow create: if isAdmin() && isValidProduct(incoming());
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    // Categories collection (dynamically displayed on landing page tabs and admin dropdowns)
    match /categories/{categoryId} {
      // Public visitors can read active categories; Admins can read all categories
      allow get, list: if resource.data.status == 'activo' || isAdmin();

      // Only verified administrators can mutate categories
      allow create: if isAdmin() && isValidCategory(incoming());
      allow update: if isAdmin() && isValidCategory(incoming());
      allow delete: if isAdmin();
    }

    // Connection health check
    match /test/connection {
      allow read: if true;
    }
  }
}
